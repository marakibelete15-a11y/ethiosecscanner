# ==============================================================================
# EthioSec Scanner - Environment Configuration Template
# NOTE: Do NOT commit actual secrets or production credentials to source control.
# ==============================================================================

# Environment mode: 'development', 'testing', or 'production'
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-secret-in-production

# JWT Authentication (Refuses to boot in production if unset)
JWT_SECRET_KEY=replace-with-a-strong-jwt-secret-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Database Configuration (PostgreSQL / Supabase or SQLite for development)
# Development default: sqlite:///ethiosec.db
# Production example: postgresql://user:password@localhost:5432/ethiosec
DATABASE_URL=sqlite:///ethiosec.db

# CORS Allowed Origins (Comma-separated list of origins)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Scanner Safety & Network Policies
SCANNER_MAX_CONCURRENT_REQUESTS=5
SCANNER_REQUEST_TIMEOUT_SECONDS=10
SCANNER_ALLOW_PRIVATE_IPS=false
