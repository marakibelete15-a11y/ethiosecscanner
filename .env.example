# ==============================================================================
# EthioSec Scanner - Environment Configuration Template
# NOTE: Do NOT commit actual secrets or production credentials to source control.
# ==============================================================================

# Application Environment: 'development', 'testing', or 'production'
ENVIRONMENT=development
DEBUG=true

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Secret Key & JWT Configuration (Refuses to boot in production if unset)
SECRET_KEY=replace-with-a-secure-random-secret-in-production
JWT_SECRET_KEY=replace-with-a-strong-jwt-secret-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Local PostgreSQL Database URLs
# Format: postgresql://<your_user>:<your_password>@localhost:5432/<your_database>
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/ethiosec_db
TEST_DATABASE_URL=postgresql://your_user:your_password@localhost:5432/ethiosec_test_db

# CORS Allowed Origins (Comma-separated; optional since FastAPI serves frontend)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Scanner Network Safety & Development Override
ALLOW_LOCAL_TARGETS=false
SCANNER_MAX_CONCURRENT_REQUESTS=5
SCANNER_REQUEST_TIMEOUT_SECONDS=10
